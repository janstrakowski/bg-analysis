      "rola": "zlanie",
      "bg": [
        2
      ],
      "zrodlo": [
        3,
        4
      ],
      "uwaga": "Emfatyczne οὐ μὴ oddane jednym „Nie”."
    },
    {
      "rola": "przeklad",
      "bg": [
        3
      ],
      "zrodlo": [
        5
      ],
      "uwaga": "ἐξέλθῃς oddane jako „wynijdziesz”."
