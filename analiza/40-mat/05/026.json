      "zrodlo": [
        6
      ],
      "uwaga": "ἐκεῖθεν oddane jako „stamtąd”."
    },
    {
      "rola": "zlanie",
      "bg": [
        5
      ],
      "zrodlo": [
        7,
        8
      ],
      "uwaga": "ἕως ἂν oddane jako „pókibyś”; -by niesie partykułę ἂν, a -ś osobę ἀποδῷς."
    },
    {
      "rola": "dopelnienie",
      "bg": [
        6
      ],
      "zrodlo": [],
      "uwaga": "Drugie „nie” nie ma osobnego przeczenia przy ἀποδῷς.",
      "uzasadnienie": "Po „póki” polszczyzna stawia przeczenie przy czasowniku, a zdanie znaczy „dopóki nie oddasz”, czyli aż oddasz."
    },
    {
      "rola": "przeklad",
      "bg": [
        7
      ],
      "zrodlo": [
        9
      ],
      "uwaga": "ἀποδῷς oddane jako „oddał”."
    },
    {
      "rola": "dopelnienie",
      "bg": [
        8
      ],
      "zrodlo": [],
      "uwaga": "„do” nie ma osobnego przyimka przy bierniku τὸν ἔσχατον κοδράντην.",
      "uzasadnienie": "Przyimek „do” stawia granicę zapłaty, którą grecki biernik nazywa wprost jako przedmiot ἀποδῷς."
    },
    {
      "rola": "przeklad",
      "bg": [
        9
      ],
      "zrodlo": [
        11
      ],
      "uwaga": "ἔσχατον oddane jako „ostatniego”."
